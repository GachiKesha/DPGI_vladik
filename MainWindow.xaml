<Window x:Class="DPGI_vladik.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DPGI_vladik"
        mc:Ignorable="d"
        Title="Number Base Converter" Height="460" Width="800">
    <Window.Resources>
        <LinearGradientBrush x:Key="LinearPanelBrush">
            <GradientStop Color="Pink" Offset="0"></GradientStop>
            <GradientStop Color="White" Offset="0.5"></GradientStop>
            <GradientStop Color="Orange" Offset="1"></GradientStop>
        </LinearGradientBrush>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="5"></Setter>
            <Setter Property="Background" Value="Transparent"></Setter>
            <Setter Property="BorderBrush" Value="White"></Setter>
        </Style>
    </Window.Resources>
    <Grid Background="{StaticResource LinearPanelBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="1">
            <TextBlock Text="Enter number" FontWeight="Bold" Margin="1"/>
            <TextBox x:Name="InputTextBox" Height="48" FontSize="30" Margin="1" />

            <TextBlock Text="From Base" FontWeight="Bold" Margin="1"/>
            <ComboBox x:Name="FromBaseComboBox" Height="48" FontSize="30" Margin="1">
                <ComboBoxItem Content="2 (binary)" Tag="2" />
                <ComboBoxItem Content="8 (octal)" Tag="8" />
                <ComboBoxItem Content="10 (decimal)" Tag="10" IsSelected="True"/>
                <ComboBoxItem Content="16 (hex)" Tag="16" />
            </ComboBox>

            <TextBlock Text="To Base" FontWeight="Bold" Margin="1"/>
            <ComboBox x:Name="ToBaseComboBox" Height="48" FontSize="30" Margin="1">
                <ComboBoxItem Content="2 (binary)" Tag="2" />
                <ComboBoxItem Content="8 (octal)" Tag="8" />
                <ComboBoxItem Content="10 (decimal)" Tag="10" />
                <ComboBoxItem Content="16 (hex)" Tag="16" IsSelected="True"/>
            </ComboBox>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"  Margin="0,20">
                <Button Content="Convert" FontWeight="Bold" Width="80" Height="30" Margin="5" Click="ConvertButton_Click"/>
                <Button Content="Reset" FontWeight="Bold" Width="80" Height="30" Margin="5" Click="ResetButton_Click"/>
                <Button Content="Swap" FontWeight="Bold" Width="80" Height="30" Margin="5" Click="SwapButton_Click"/>
            </StackPanel>

            <TextBlock Text="Result number" FontWeight="Bold" Margin="0,10"/>
            <TextBox x:Name="ResultTextBox" Height="48" FontSize="30" Margin="0,5" IsReadOnly="True"/>

            <Button Content="Copy" Width="80" Height="30" Margin="5" Click="CopyButton_Click"/>
        </StackPanel>
    </Grid>
</Window>

