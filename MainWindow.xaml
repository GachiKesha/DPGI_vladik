<Window x:Class="DPGI_vladik.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DPGI_vladik"
        mc:Ignorable="d"
        Title="TextEditor" Height="450" Width="800">
    <Window.Resources>
        <LinearGradientBrush x:Key="LinearPanelBrush">
            <GradientStop Color="Yellow" Offset="0"></GradientStop>
            <GradientStop Color="Cyan" Offset="0.5"></GradientStop>
            <GradientStop Color="Yellow" Offset="1"></GradientStop>
        </LinearGradientBrush>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="5"></Setter>
            <Setter Property="Background" Value="Transparent"></Setter>
            <Setter Property="BorderBrush" Value="White"></Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" BorderBrush="DarkCyan" BorderThickness="2" CornerRadius="10" Background="{StaticResource LinearPanelBrush}"></Border>
        <StackPanel Orientation="Horizontal" Grid.Row="0" Height="60">
            <Button Command="Open">
                <Image Source="images/open.png" ToolTip="Open" />
            </Button>
            <Button Command="Delete">
                <Image Source="images/erase.png" ToolTip="Erase" />
            </Button>
            <Button Command="Copy" CommandTarget="{Binding ElementName=inputTextBox}">
                <Image Source="images/copy.png" ToolTip="Copy"/>
            </Button>
            <Button Command="Paste" CommandTarget="{Binding ElementName=inputTextBox}">
                <Image Source="images/paste.png" ToolTip="Paste" />
            </Button>
        </StackPanel>
        <Border Grid.Row="1" BorderBrush="DarkCyan" BorderThickness="2" CornerRadius="10" Background="{StaticResource LinearPanelBrush}"></Border>
        <Grid Grid.Row="1" Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
            </Grid.RowDefinitions>
            <ScrollViewer Margin="30">
                <TextBox Grid.Row="0" Name="inputTextBox" Text="Text" TextWrapping="Wrap" FontSize="{Binding ElementName=fontSlider, Path=Value, UpdateSourceTrigger=PropertyChanged}"></TextBox>
            </ScrollViewer>
            <DockPanel Grid.Row="1" Margin="30,0,0,0">
                <Label>Розмір шрифту :</Label>
                <Slider Margin="4" MinWidth="100" Name="fontSlider" Maximum="100" Minimum="12" />
                <Button DockPanel.Dock="Bottom" Width="20" Margin="0,0,0,20" Style="{x:Null}" ToolTip="Зберегти" Command="Save">Ok</Button>
            </DockPanel>
        </Grid>
    </Grid>
</Window>

