<Window x:Class="DPGI_vladik.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DPGI_vladik"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <DockPanel>
        <Label  DockPanel.Dock ="Top" Content="Label" HorizontalAlignment="Center"/>
        <TextBox Text="TextBox" TextWrapping="Wrap" DockPanel.Dock ="Left" Width="320" />
        <TextBox Text="TextBox" TextWrapping="Wrap"  DockPanel.Dock ="Right" Width="320"  />
        <Button  Content="Button" Height="20" Width="100" Margin="0,350,0,0"/>
    </DockPanel>
</Window>
