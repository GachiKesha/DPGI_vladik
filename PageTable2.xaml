<Page x:Class="DPGI_vladik.PageTable2"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:DPGI_vladik"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="PageTable2">

    <Grid>
        <DataGrid x:Name="ConvertedNotes" Margin="10" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Decimal" Binding="{Binding Decimal}" />
                <DataGridTextColumn Header="Binary" Binding="{Binding Binary}" />
                <DataGridTextColumn Header="Octal" Binding="{Binding Octal}" />
                <DataGridTextColumn Header="Hexadecimal" Binding="{Binding Hexidecimal}" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>
