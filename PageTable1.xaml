<Page x:Class="DPGI_vladik.PageTable1"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:DPGI_vladik"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="PageTable1">

    <Page.CommandBindings>
        <CommandBinding Command="local:DataCommands.Undo" Executed="UndoCommandBinding_Executed" CanExecute="UndoCommandBinding_CanExecute" />
        <CommandBinding Command="local:DataCommands.Find" Executed="FindCommandBinding_Executed" CanExecute="FindCommandBinding_CanExecute" />
        <CommandBinding Command="local:DataCommands.Delete" Executed="DeleteCommandBinding_Executed" CanExecute="DeleteCommandBinding_CanExecute" />
    </Page.CommandBindings>

    <Grid>
        <StackPanel>
            <StackPanel>
                <Menu>
                    <MenuItem Header="Дія" BorderThickness="3">
                        <MenuItem Header="Скасувати" Command="local:DataCommands.Undo"/>
                        <Separator/>
                        <MenuItem Header="Знайти" Command="local:DataCommands.Find"/>
                        <Separator/>
                        <MenuItem Header="Видалити" Command="local:DataCommands.Delete"/>
                    </MenuItem>
                    <MenuItem Header="Звіт"/>
                </Menu>
                <ToolBar>
                    <Button Name="Скасувати" Margin="5,2,5,2" Command="local:DataCommands.Undo" ToolTip="Скасування">
                        <Image Source="Images/undo.png" Width="24" Height="24"/>
                    </Button>
                    <Button Name="Знайти" Margin="5,2,5,2" Command="local:DataCommands.Find" ToolTip="Пошук">
                        <Image Source="Images/search.png" Width="24" Height="24"/>
                    </Button>
                    <Button Name="Видалити" Margin="5,2,5,2" Command="local:DataCommands.Delete" ToolTip="Видалення">
                        <Image Source="Images/delete.png" Width="24" Height="24"/>
                    </Button>
                </ToolBar>
            </StackPanel>
            <TextBlock Text="Історія конвертацій (0b* - Bin, 0* - Oct, 0x* - Hex) " FontWeight="Bold" FontSize="16" Margin="5"/>
            <DataGrid x:Name="HistoryGrid" SelectionChanged="HistoryGrid_SelectionChanged"
                      AutoGenerateColumns="False" IsReadOnly="True" Margin="0,5"
                      EnableRowVirtualization="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Вхідне" Binding="{Binding InputValue}" />
                    <DataGridTextColumn Header="Результат" Binding="{Binding OutputValue}" />
                    <DataGridTextColumn Header="Час" Binding="{Binding Timestamp}" />
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
        <Border Background="#CCFFFFFF" Padding="5" CornerRadius="5" Visibility="Collapsed"
            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10"
            Panel.ZIndex="100" x:Name="SearchPanel" Width="300" Height="40" >
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBox x:Name="SearchTextBox" Width="200" VerticalAlignment="Center" Margin="0,0,5,0"
                         TextChanged="SearchTextBox_TextChanged"/>
                <Button Content="&#x25B2;" Width="30" Click="SearchPrevious_Click" />
                <Button Content="&#x25BC;" Width="30" Click="SearchNext_Click" />
                <Button Content="X" Width="30" Click="CloseSearchPanel_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Page>
